{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SetupCenterVaultCacheSchema",
  "description": "Schema definition for cached Vault client data persisted in localStorage",
  "type": "object",
  "required": ["manifest", "syncedAt", "styles", "resources", "templates", "patterns"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "manifest": {
      "type": "object",
      "required": ["schemaVersion", "contentVersion", "name", "collections"]
    },
    "syncedAt": { "type": "string" },
    "styles": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "resources": {
      "type": "array",
      "items": { "type": "object" }
    },
    "templates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "patterns": {
      "type": "array",
      "items": { "type": "object" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "object" }
    },
    "extensions": {
      "type": "object"
    }
  }
}
